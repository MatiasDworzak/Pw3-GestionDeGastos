@using GestionDeGastos.Models.GastoModels
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model AgregarGastoViewModel
@await Html.PartialAsync("_Header")

<h3 class="text-center">Agregar Gasto</h3>
@{
    if (TempData["ErrorEnSubida"] != null)
    {
        <div id="errorAlert" class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorEnSubida"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
}

<form id="form-agregar-gasto" asp-action="Agregar" method="post" enctype="multipart/form-data">
    <h4>Detalles del gasto</h4>
    <!-- Los inputs van a ser cambiados por los Atributos del ViewModel que se disenie -->
    <!--Parte principal del datos del gasto -->
    <div class="row d-flex justify-content-evenly">
        <div class="col-6 gap-2 d-flex flex-column">
            <input asp-for="Nombre" class="form-control" placeholder="Nombre" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
            <div>
                <input class="form-check-input" type="radio" id="sin-ticket" asp-for="OpcionTicketSeleccionada" value="SinTicket" />
                <label class="form-check-label ms-1" for="sin-ticket">No agregar Ticket</label><br />

                <input class="form-check-input radio-con-section" type="radio" id="ticket-manual" asp-for="OpcionTicketSeleccionada" value="TicketManual" />
                <label class="form-check-label ms-1" for="ticket-manual">Agregar Ticket Manual</label><br />

                <input class="form-check-input radio-con-section" type="radio" id="ticket-foto" asp-for="OpcionTicketSeleccionada" value="TicketFoto" />
                <label class="form-check-label ms-1" for="ticket-foto">Agregar Ticket con Foto</label><br />
                <span asp-validation-for="OpcionTicketSeleccionada" class="text-danger"></span>
            </div>
        </div>
        <div class="col-6 d-flex flex-column gap-2">
            <div class="row g-2">
                <div class="col-6" id="fecha-container">
                    <input asp-for="Fecha" type="date" class="w-100 form-control" placeholder="Fecha" />
                    <span asp-validation-for="Fecha" class="text-danger"></span>
                </div>
                <div class="col-6" id="monto-inical-container">
                    <input asp-for="MontoTotal" class="w-100 form-control" placeholder="Monto" />
                    <span asp-validation-for="MontoTotal" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex flex-column gap-2">
                <select asp-for="CategoriaSeleccionada" class="form-select text-center" id="categoria"
                        asp-items="Model.Categorias">
                    <option value="" selected disabled>Seleccionar Categoria</option>
                    <!-- Iterar categorias(del sistema generales y las generadas por usuario) de base de datos -->
                    <!-- <option value="">Agregar Categoria</option> definir si esto hacerlo un boton -->
                </select>
                <span asp-validation-for="CategoriaSeleccionada" class="text-danger"></span>

                <select asp-for="MetodoDePagoSeleccionado" class="form-select text-center" id="metodo-de-pago"
                        asp-items="Model.MetodosDePago">
                    <option value="" selected disabled>Metodo de Pago</option>
                    <!-- Iterar metodos de pago de base de datos -->
                </select>
                <span asp-validation-for="MetodoDePagoSeleccionado" class="text-danger"></span>
            </div>
        </div>
    </div>

    <!-- Seccion que se abre con el radio button Agregar Ticket con Foto -->
    <section id="ticket-foto-section" class="d-none">
        <h4>Agregar ticket con foto</h4>
        <div class="d-flex justify-content-center gap-2">
            <div>
                <input asp-for="TicketFoto" class="form-control" id="formFile" type="file" />
                <span asp-validation-for="TicketFoto" class="text-danger"></span>
            </div>
            <div>
                <label class="btn btn-info" for="formFile">Escanear Ticket</label>
            </div>
        </div>
    </section>

    <!-- Seccion que se abre con el radio button Agregar Ticket Manual -->
    <section id="ticket-manual-section" class="d-none">
        <h4 class="mt-2">Agregar ticket manual</h4>
        @for (int i = 0; i < Model.Items.Count; i++)
        {
            <div class="row p-0 mt-2 item-data-container">
                <div class="col-3">
                    <input asp-for="Items[@i].Descripcion" class="form-control input-original-item" type="text" placeholder="Nombre Producto" />
                    <span asp-validation-for="Items[@i].Descripcion" class="text-danger"></span>
                </div>
                <div class="col-3">
                    <input asp-for="Items[@i].Cantidad" class="form-control input-original-item" type="number" placeholder="Cantidad" />
                    <span asp-validation-for="Items[@i].Cantidad" class="text-danger"></span>
                </div>
                <div class="col-3">
                    <input asp-for="Items[@i].PrecioUnitario" class="form-control input-original-item" type="number" placeholder="Precio x Unidad" />
                    <span asp-validation-for="Items[@i].PrecioUnitario" class="text-danger"></span>
                </div>
                <div class="col-3">
                    <button type="button" class="btn btn-danger w-100 eliminar-item">Eliminar</button>
                </div>
            </div>
        }
        <div class="mt-2 d-flex justify-content-start">
            <div class="btn btn-primary w-auto" id="nuevo-item">+ Nuevo item</div>
        </div>
        <!--Modal por si quiere borrar el ultimo item-->
        <div class="modal fade" id="modal-eliminar-ultimo-item" tabindex="-1" aria-labelledby="miModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="miModalLabel">Gasto sin items</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        Si elimina todos los items su gasto se procesara sin ticket. ¿Seguro que quieres borrar el ultimo item?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" id="btn-modal-sin-ticket" class="btn btn-primary">Borrar</button>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <div class="d-flex justify-content-end mt-2">
        <input class="btn btn-info" type="submit" value="Subir" />
    </div>
</form>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/GastoAgregar.js"></script>
}