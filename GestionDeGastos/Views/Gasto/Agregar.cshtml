@using GestionDeGastos.Models.GastoModels

@section Css {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/css/bootstrap-select.min.css">
    <link rel="stylesheet" href="~/css/custom-styles.css">
}

@model AgregarGastoViewModel
@await Html.PartialAsync("_Header")

<div class="container-fluid p-4" style="min-height: 100vh;">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Card Principal -->
            <div class="card border-0 shadow-lg" style="border-radius: 20px;">
                <div class="card-header border-0 text-white" style="background: #4ABDAC; border-radius: 20px 20px 0 0; padding: 2rem;">
                    <h3 class="mb-0 fw-bold text-center">
                        <i class="bi bi-plus-circle me-2"></i>Agregar Nuevo Gasto
                    </h3>
                </div>
                
                <div class="card-body p-4">
                    @{
                        if (TempData["ErrorEnSubida"] != null)
                        {
                            <div id="errorAlert" class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorEnSubida"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                            </div>
                        }
                    }

                    <form id="form-agregar-gasto" asp-action="Agregar" method="post" enctype="multipart/form-data">
                        <!-- Detalles del Gasto -->
                        <div class="mb-4">
                            <h5 class="fw-bold mb-3" style="color: #4ABDAC;">
                                <i class="bi bi-info-circle me-2"></i>Detalles del Gasto
                            </h5>
                            
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Nombre del Gasto</label>
                                    <input asp-for="Nombre" class="form-control form-control-lg" placeholder="Ej: Supermercado" />
                                    <span asp-validation-for="Nombre" class="text-danger"></span>
                                </div>
                                
                                <div class="col-md-3">
                                    <label class="form-label fw-semibold">Fecha</label>
                                    <input id="Fecha" asp-for="Fecha" type="date" class="form-control form-control-lg" />
                                    <span asp-validation-for="Fecha" class="text-danger"></span>
                                </div>
                                
                                <div class="col-md-3">
                                    <label class="form-label fw-semibold">Monto Total</label>
                                    <input asp-for="MontoTotal" class="form-control form-control-lg" placeholder="$0.00" />
                                    <span asp-validation-for="MontoTotal" class="text-danger"></span>
                                </div>
                                
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Categoría</label>
                                    <select asp-for="CategoriaSeleccionada"
                                            class="selectpicker form-control"
                                            data-width="100%"
                                            data-live-search="true"
                                            id="categoria">
                                        <option value="" selected disabled>Seleccionar Categoría</option>
                                        @foreach (var categoria in Model.Categorias)
                                        {
                                            <option value="@categoria.Id"
                                                    data-content="<span class='material-icons' style='vertical-align: middle; margin-right: 5px; color:@categoria.Color;'>@categoria.Icono</span> @categoria.Nombre">
                                                @categoria.Nombre
                                            </option>
                                        }
                                    </select>
                                    <span asp-validation-for="CategoriaSeleccionada" class="text-danger"></span>
                                </div>
                                
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Método de Pago</label>
                                    <select asp-for="MetodoDePagoSeleccionado"
                                            class="selectpicker form-control"
                                            data-width="100%"
                                            id="metodo-de-pago">
                                        <option value="" selected disabled>Seleccionar Método de Pago</option>
                                        @foreach (var metodo in Model.MetodosDePago)
                                        {
                                            <option value="@metodo.Id"
                                                    data-content="<span class='material-icons' style='vertical-align: middle; margin-right: 5px; color:@metodo.Color;'>@metodo.Icono</span> @metodo.Nombre">
                                                @metodo.Nombre
                                            </option>
                                        }
                                    </select>
                                    <span asp-validation-for="MetodoDePagoSeleccionado" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Opciones de Ticket -->
                        <div class="mb-4">
                            <h5 class="fw-bold mb-3" style="color: #4ABDAC;">
                                <i class="bi bi-receipt me-2"></i>Opciones de Ticket
                            </h5>
                            
                            <div class="card border-0" style="background: #DFDCE3;">
                                <div class="card-body">
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="radio" id="sin-ticket" asp-for="OpcionTicketSeleccionada" value="SinTicket" />
                                        <label class="form-check-label fw-semibold" for="sin-ticket">
                                            <i class="bi bi-x-circle me-2"></i>No agregar Ticket
                                        </label>
                                    </div>
                                    
                                    <div class="form-check mb-2">
                                        <input class="form-check-input radio-con-section" type="radio" id="ticket-manual" asp-for="OpcionTicketSeleccionada" value="TicketManual" />
                                        <label class="form-check-label fw-semibold" for="ticket-manual">
                                            <i class="bi bi-pencil-square me-2"></i>Agregar Ticket Manual
                                        </label>
                                    </div>
                                    
                                    <div class="form-check">
                                        <input class="form-check-input radio-con-section" type="radio" id="ticket-foto" asp-for="OpcionTicketSeleccionada" value="TicketFoto" />
                                        <label class="form-check-label fw-semibold" for="ticket-foto">
                                            <i class="bi bi-camera me-2"></i>Agregar Ticket con Foto
                                        </label>
                                    </div>
                                    <span asp-validation-for="OpcionTicketSeleccionada" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Sección Ticket con Foto -->
                        <section id="ticket-foto-section" class="d-none mb-4">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body">
                                    <h5 class="fw-bold mb-3" style="color: #4ABDAC;">
                                        <i class="bi bi-camera-fill me-2"></i>Subir Foto del Ticket
                                    </h5>
                                    <div class="row g-3">
                                        <div class="col-md-8">
                                            <input asp-for="TicketFoto" class="form-control form-control-lg" id="formFile" type="file" />
                                            <span asp-validation-for="TicketFoto" class="text-danger"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <button id="btn-escanear-ticket" type="button" class="btn btn-lg w-100 text-white fw-semibold" style="background: #FC4A1A;">
                                                <i class="bi bi-upc-scan me-2"></i>Escanear Ticket
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- Sección Ticket Manual -->
                        <section id="ticket-manual-section" class="d-none mb-4">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body">
                                    <h5 id="titulo-ticket-manual-section" class="fw-bold mb-3" style="color: #4ABDAC;">
                                        <i class="bi bi-list-ul me-2"></i>Items del Ticket
                                    </h5>
                                    
                                    <div id="aviso-ticket-escaneado" class="d-none alert alert-warning mb-3" role="alert">
                                        <i class="bi bi-info-circle me-2"></i>
                                        Los datos fueron obtenidos automáticamente del ticket.
                                        Por favor, verificá y corregí cualquier valor antes de confirmar el gasto.
                                    </div>
                                    
                                    <div class="row">
                                        <div id="columna-items" class="col-md-9">
                                            <div class="row mb-3">
                                                <div class="col-3">
                                                    <label class="fw-semibold small">Nombre Producto</label>
                                                </div>
                                                <div class="col-3">
                                                    <label class="fw-semibold small">Cantidad</label>
                                                </div>
                                                <div class="col-3">
                                                    <label class="fw-semibold small">Precio x Unidad</label>
                                                </div>
                                            </div>
                                            
                                            @for (int i = 0; i < Model.Items.Count; i++)
                                            {
                                                <div class="row mb-2 item-data-container">
                                                    <div class="col-3">
                                                        <input asp-for="Items[@i].Descripcion" class="form-control input-original-item" type="text" placeholder="Producto" />
                                                        <span asp-validation-for="Items[@i].Descripcion" class="text-danger small"></span>
                                                    </div>
                                                    <div class="col-3">
                                                        <input asp-for="Items[@i].Cantidad" class="form-control input-original-item" type="number" placeholder="Cant." />
                                                        <span asp-validation-for="Items[@i].Cantidad" class="text-danger small"></span>
                                                    </div>
                                                    <div class="col-3">
                                                        <input asp-for="Items[@i].PrecioUnitario" class="form-control input-original-item" type="number" placeholder="Precio" />
                                                        <span asp-validation-for="Items[@i].PrecioUnitario" class="text-danger small"></span>
                                                    </div>
                                                    <div class="col-3">
                                                        <button type="button" class="btn btn-sm w-100 text-white fw-semibold eliminar-item" style="background: #FC4A1A;">
                                                            <i class="bi bi-trash me-1"></i>Eliminar
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        
                                        <div id="columna-imagen" class="col-md-3">
                                            <img id="preview-ticket" class="img-thumbnail d-none w-100"
                                                 style="cursor: pointer;"
                                                 data-bs-toggle="modal"
                                                 data-bs-target="#modalImagen">
                                        </div>
                                    </div>
                                    
                                    <div class="mt-3">
                                        <button type="button" class="btn text-white fw-semibold" style="background: #4ABDAC;" id="nuevo-item">
                                            <i class="bi bi-plus-circle me-2"></i>Agregar Item
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- Botón Submit -->
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="Home" asp-action="Home" class="btn btn-lg btn-secondary px-4">
                                <i class="bi bi-x-circle me-2"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-lg text-dark fw-semibold px-5" style="background: #F7B733;">
                                <i class="bi bi-check-circle me-2"></i>Guardar Gasto
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Eliminar Último Item -->
<div class="modal fade" id="modal-eliminar-ultimo-item" tabindex="-1" aria-labelledby="miModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px;">
            <div class="modal-header border-0" style="background: #FC4A1A; border-radius: 15px 15px 0 0;">
                <h5 class="modal-title text-white fw-bold" id="miModalLabel">
                    <i class="bi bi-exclamation-triangle me-2"></i>Gasto sin Items
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                Si elimina todos los items su gasto se procesará sin ticket. ¿Seguro que quieres borrar el último item?
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btn-modal-sin-ticket" class="btn text-white" style="background: #FC4A1A;">Borrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Imagen Ampliada -->
<div class="modal fade" id="modalImagen" tabindex="-1" aria-labelledby="modalImagenLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-transparent border-0 shadow-none">
            <div class="modal-body text-center p-0">
                <img id="preview-ticket-modal" class="img-fluid rounded" style="max-height: 90vh; object-fit: contain;" />
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/GastoAgregar.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/js/bootstrap-select.min.js"></script>
    <script>
        $(document).ready(function() {
            $('.selectpicker').selectpicker();
        });
    </script>
}
