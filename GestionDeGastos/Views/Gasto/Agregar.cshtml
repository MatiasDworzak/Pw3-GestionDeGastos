@using GestionDeGastos.Models.GastoModels
@model AgregarGastoViewModel
@await Html.PartialAsync("_Header")

<link rel="stylesheet" href="~/css/agregar-gasto.css" />

<div class="page-container">
    <div class="page-header">
        <h1>➕ Agregar Gasto</h1>
        <p class="subtitle">Registra un nuevo gasto en tu cuenta</p>
    </div>

    @if (TempData["ErrorEnSubida"] != null)
        {
            <div id="errorAlert" class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorEnSubida"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
    }

    <form id="form-agregar-gasto" asp-action="Agregar" method="post" enctype="multipart/form-data">
        <div class="form-card">
            <div class="form-section">
                <h3>📝 Detalles del Gasto</h3>
                <div class="form-grid">
                    <!-- Opción de Ticket PRIMERO -->
                    <div class="form-group full-width">
                        <label>Opción de Ticket</label>
                        <div class="radio-group">
                            <div class="radio-option">
                    <input class="form-check-input" type="radio" id="sin-ticket" asp-for="OpcionTicketSeleccionada" value="SinTicket" />
                                <label class="form-check-label" for="sin-ticket">No agregar Ticket</label>
                            </div>
                            <div class="radio-option">
                    <input class="form-check-input radio-con-section" type="radio" id="ticket-manual" asp-for="OpcionTicketSeleccionada" value="TicketManual" />
                                <label class="form-check-label" for="ticket-manual">Agregar Ticket Manual</label>
                            </div>
                            <div class="radio-option">
                    <input class="form-check-input radio-con-section" type="radio" id="ticket-foto" asp-for="OpcionTicketSeleccionada" value="TicketFoto" />
                                <label class="form-check-label" for="ticket-foto">Agregar Ticket con Foto</label>
                            </div>
                        </div>
                    <span asp-validation-for="OpcionTicketSeleccionada" class="text-danger"></span>
                </div>

                    <!-- Detalles más compactos -->
                    <div class="form-group">
                        <label asp-for="Nombre">Nombre</label>
                        <input asp-for="Nombre" placeholder="Ej: Supermercado" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

                    <div class="form-group">
                        <label asp-for="Fecha">Fecha</label>
                        <input id="Fecha" asp-for="Fecha" type="date" />
                        <span asp-validation-for="Fecha" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="MontoTotal">Monto</label>
                        <input id="MontoTotal" asp-for="MontoTotal" placeholder="0.00" />
                        <span asp-validation-for="MontoTotal" class="text-danger"></span>
                </div>

                    <div class="form-group">
                        <label asp-for="CategoriaSeleccionada">Categoría</label>
                        <select asp-for="CategoriaSeleccionada" id="categoria" asp-items="Model.Categorias">
                            <option value="" selected disabled>Seleccionar</option>
                    </select>
                    <span asp-validation-for="CategoriaSeleccionada" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="MetodoDePagoSeleccionado">Método Pago</label>
                        <select asp-for="MetodoDePagoSeleccionado" id="metodo-de-pago" asp-items="Model.MetodosDePago">
                            <option value="" selected disabled>Seleccionar</option>
                    </select>
                    <span asp-validation-for="MetodoDePagoSeleccionado" class="text-danger"></span>
                </div>
            </div>
        </div>

            <!-- Sección Ticket con Foto -->
            <section id="ticket-foto-section" class="section-toggle d-none">
                <h4>📷 Agregar Ticket con Foto</h4>
                <div class="file-upload-section">
                    <div class="form-group">
                        <label asp-for="TicketFoto">Seleccionar Imagen</label>
                        <input asp-for="TicketFoto" id="formFile" type="file" accept="image/*" />
                    <span asp-validation-for="TicketFoto" class="text-danger"></span>
                </div>
                    <button id="btn-escanear-ticket" type="button" class="btn-escanear">🔍 Escanear Ticket</button>
            </div>
        </section>

            <!-- Sección Ticket Manual -->
            <section id="ticket-manual-section" class="section-toggle d-none">
                <h4 id="titulo-ticket-manual-section">✏️ Agregar Ticket Manual</h4>
                <div id="aviso-ticket-escaneado" class="alert alert-warning d-none" role="alert">
                    ⚠️ Los datos fueron obtenidos automáticamente del ticket. Por favor, verificá y corregí cualquier valor antes de confirmar el gasto.
            </div>

            <div class="row">
                 <div id="columna-items" class="col-9">
                        <div class="items-section">
                            <div class="items-header">
                                <h5>Nombre Producto</h5>
                                <h5>Cantidad</h5>
                                <h5>Precio x Unidad</h5>
                                <h5>Acción</h5>
                         </div>

                    @for (int i = 0; i < Model.Items.Count; i++)
                    {
                        <div class="item-row item-data-container">
                            <div class="item-cell">
                                <input asp-for="Items[@i].Descripcion" class="input-original-item" type="text" placeholder="Nombre Producto" />
                                <span asp-validation-for="Items[@i].Descripcion" class="item-validation"></span>
                            </div>
                            <div class="item-cell">
                                <input asp-for="Items[@i].Cantidad" class="input-original-item" type="number" placeholder="Cantidad" step="0.01" />
                                <span asp-validation-for="Items[@i].Cantidad" class="item-validation"></span>
                            </div>
                            <div class="item-cell">
                                <input asp-for="Items[@i].PrecioUnitario" class="input-original-item" type="number" placeholder="Precio x Unidad" step="0.01" />
                                <span asp-validation-for="Items[@i].PrecioUnitario" class="item-validation"></span>
                            </div>
                            <div class="item-cell">
                                <button type="button" class="btn-eliminar eliminar-item">🗑️ Eliminar</button>
                            </div>
                        </div>
                    }
                        </div>
                        <button type="button" class="btn-nuevo-item" id="nuevo-item">➕ Nuevo Item</button>
                 </div>
                <div id="columna-imagen" class="col-3">
                        <img id="preview-ticket" class="preview-image d-none" style="max-width: 300px;" />
                 </div>
            </div>
            </section>

            <div class="form-actions">
                <input class="btn-submit" type="submit" value="💾 Guardar Gasto" />
            </div>
        </div>
    </form>
</div>

<!-- Modal Eliminar Último Item -->
            <div class="modal fade" id="modal-eliminar-ultimo-item" tabindex="-1" aria-labelledby="miModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                <h5 class="modal-title" id="miModalLabel">⚠️ Gasto sin items</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                        </div>
                        <div class="modal-body">
                Si elimina todos los items, su gasto se procesará sin ticket. ¿Seguro que quieres borrar el último item?
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="button" id="btn-modal-sin-ticket" class="btn btn-primary">Borrar</button>
                        </div>
                    </div>
                </div>
            </div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/GastoAgregar.js"></script>
}
