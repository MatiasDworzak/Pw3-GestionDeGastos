@{
    var nombreUsuario = Context.Session.GetString("UsuarioNombre");
    var mailUsuario = Context.Session.GetString("UsuarioEmail");

}

<header class="border-bottom shadow-sm bg-white mb-4">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center">
            <!-- Izquierda: Logo y dropdown de acciones -->
            <div class="d-flex align-items-center">
                <a class="navbar-brand fw-bold d-flex align-items-center text-decoration-none text-dark"
                   asp-area="" asp-controller="Home" asp-action="Home">
                    <i class="bi bi-file-earmark-text me-2"></i>
                    AhorrApp
                </a>

                <div class="dropdown">
                    <button class="btn p-0 border-0 bg-transparent text-muted"
                            id="accionesMenu" data-bs-toggle="dropdown" aria-expanded="false" type="button">
                        <i class="bi bi-caret-down-fill small"></i>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="accionesMenu">
                        <li>
                            <a asp-controller="Presupuesto" asp-action="PresupuestoActual"
                               class="dropdown-item d-flex align-items-center">
                                <i class="bi bi-wallet2 text-muted small me-2"></i>
                                Presupuestos
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Gasto" asp-action="Agregar"
                               class="dropdown-item d-flex align-items-center">
                                <i class="bi bi-plus-circle text-muted small me-2"></i>
                                Agregar gasto
                            </a>
                        </li>
                        <li>
                            <a asp-controller="VerTodosLosGastos" asp-action="VerTodosLosGastos"
                               class="dropdown-item d-flex align-items-center">
                                <i class="bi bi-list-task text-muted small me-2"></i>
                                Ver todos los gastos
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Derecha: Usuario -->
            <div class="d-flex align-items-center gap-3 text-end">
                <!-- Nombre y email -->
                <div class="text-end">
                    <div class="fw-bold">@nombreUsuario</div>
                    <small class="text-muted">@mailUsuario</small>
                </div>

                <!-- Menú desplegable -->
                <div class="dropdown">
                    <button class="btn p-0 border-0 bg-transparent" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center text-white fw-bold"
                             style="width: 45px; height: 45px;">
                            @nombreUsuario.Substring(0, 1).ToUpper()
                        </div>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userMenu">
                        <li>
                            <form asp-controller="Ingreso" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger w-100">Cerrar sesión</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</header>