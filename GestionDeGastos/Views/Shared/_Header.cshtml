@model UsuarioViewModel

<header class="border-bottom shadow-sm bg-white mb-4">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center py-3">

            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center text-white fw-bold"
                     style="width: 45px; height: 45px;">
                    @Model.Nombre.Substring(0, 1).ToUpper()
                </div>
                <div>
                    <div class="fw-bold">@Model.Nombre</div>
                    <small class="text-muted">@Model.Email</small>
                </div>
            </div>

            <form asp-controller="Ingreso" asp-action="Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Cerrar Sesión</button>
            </form>

        </div>
    </div>
</header>