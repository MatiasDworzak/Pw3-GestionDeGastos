@using GestionDeGastos.Models.GastoModels
@model GastoViewModel
@await Html.PartialAsync("_Header")

@section Css {
    <link rel="stylesheet" href="~/css/home.css" />
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="container-fluid home-container">
    <div class="row justify-content-center">

        <!-- COLUMNA IZQUIERDA (Gráfico) -->
        <div class="col-md-5 chart-section">
            <div class="chart-header">
                <p class="chart-title">TIEMPO ANALIZADO EN GRÁFICO:</p>
                <p id="rango-fechas" class="chart-date-range">dd/mm/aaaa - dd/mm/aaaa</p>
            </div>

            <form id="filtroFechasForm" class="filter-form">
                <input type="month" id="filtroMes" name="mes" class="filter-input form-control">
                <input type="date" id="desde" name="desde" class="filter-input form-control">
                <input type="date" id="hasta" name="hasta" class="filter-input form-control">
                <button type="submit" class="filter-btn">Filtrar</button>
            </form>

            <!-- Contenedor de gráfico -->
            <div class="chart-container">
                <div id="chart_div"></div>
            </div>

            <!-- Contenedor para el top 3 -->
            <div id="topCategorias" class="top-categories d-none">
                <p class="top-categories-title">TOP CATEGORÍAS CON MAYOR GASTO EN EL PERIODO</p>
                <div id="topCategoriasContenido" class="top-categories-content"></div>
            </div>
        </div>

        <!-- COLUMNA DERECHA (Presupuesto, Acciones rápidas, etc) -->
        <div class="col-md-5 budget-section ms-md-3 mt-3 mt-md-0">
            <div class="budget-header">
                <h6 class="budget-title">
                    Presupuesto Actual
                    @if (Model.LimitePresupuesto == 0)
                    {
                        <span class="bi bi-exclamation-triangle-fill text-warning"
                              data-bs-toggle="tooltip"
                              data-bs-placement="top"
                              title="Tu presupuesto está en $0. Agregá un monto para empezar a planificar.">
                        </span>
                    }
                </h6>
                <a asp-controller="Presupuesto" asp-action="PresupuestoActual" class="budget-link">Ver Presupuestos</a>
            </div>

            @{
                string progressColor = Model.Porcentaje switch
                {
                    var porcentaje when porcentaje < 50 => "bg-success",
                    var porcentaje when porcentaje >= 50 && porcentaje < 80 => "bg-warning",
                    _ => "bg-danger",
                };
            }

            <div class="progress-container">
                <div class="progress">
                    <div class="progress-bar @progressColor" role="progressbar"
                         style="width:@Model.Porcentaje.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;">
                        @Model.Porcentaje.ToString("0.##")%
                    </div>
                </div>
            </div>

            <div class="quick-actions">
                <h6 class="quick-actions-title">Acciones Rápidas</h6>
                <div class="quick-actions-grid">
                    <a asp-action="Agregar" asp-controller="Gasto" class="quick-action-btn">+ Agregar Gasto</a>
                </div>
            </div>

            <div class="recent-expenses">
                <div class="recent-expenses-header">
                    <h6 class="recent-expenses-title">Gastos Recientes</h6>
                    <a asp-controller="VerTodosLosGastos" asp-action="VerTodosLosGastos" class="recent-expenses-link">Ver todos mis gastos</a>
                </div>
                <div class="expense-list">
                    @foreach (var gasto in Model.ListaUltimosTresGastos)
                    {
                        <a asp-controller="GastoEspecifico"
                           asp-action="GastoEspecifico"
                           asp-route-id="@gasto.IdGasto"
                           class="expense-item">
                            <div class="expense-item-content">
                                <span class="material-icons expense-icon"
                                      style="color:@gasto.IdCategoriaNavigation.Color;">
                                    @gasto.IdCategoriaNavigation.Icono
                                </span>
                                <div class="expense-details">
                                    <div class="expense-name">@gasto.Nombre</div>
                                    <div class="expense-date">@gasto.Fecha</div>
                                </div>
                            </div>
                            <span class="expense-amount">
                                @gasto.MontoTotal.ToString("C2")
                            </span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
<script type="text/javascript" src="~/js/FiltradoPorFechaYGraficoDeGastos.js"></script>
@section Scripts {
    <script>
        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        tooltipTriggerList.forEach(el => new bootstrap.Tooltip(el));
    </script>
}
