@* @model UsuarioViewModel *@

<div class="alert alert-success">@TempData["LoginExito"]</div>

<div class="container-fluid p-4" style="background: #e3e9ff; min-height: 100vh;">
    <div class="row justify-content-center">

        <div class="col-md-5 p-4 rounded-3 shadow-sm" style="background: #a7c9f5;">
            <div class="text-center mb-3">
                <p class="fw-bold mb-0">TIEMPO ANALIZADO EN GRÁFICO:</p>
                <p>dd/mm/aaaa - dd/mm/aaaa</p>
            </div>

            <div class="row text-center mb-3">
                <div class="col">
                    <p class="fw-semibold mb-1">Filtrar por Mes</p>
                    <button class="btn btn-sm btn-danger w-75">Seleccionar Mes</button>
                </div>
                <div class="col">
                    <p class="fw-semibold mb-1">Filtrar por Tiempo</p>
                    <div class="d-flex justify-content-center gap-2">
                        <button class="btn btn-sm btn-danger">Desde</button>
                        <button class="btn btn-sm btn-danger">Hasta</button>
                    </div>
                </div>
            </div>


            <!-- Contenedor de gráficos -->
            <div class="position-relative text-center">
                <div id="chart_div" style="width: 100%; height: 300px;"></div>

                <!-- Flechas de navegación -->
                <div class="d-flex justify-content-center align-items-center gap-3 mt-2">
                    <button id="prevChart" class="btn btn-sm border-0" style="color: black;">
                        <i class="bi bi-chevron-left fs-4"></i>
                    </button>
                    <button id="nextChart" class="btn btn-sm border-0" style="color: black;">
                        <i class="bi bi-chevron-right fs-4"></i>
                    </button>
                </div>

                <!-- Contenedor para el top 3 (solo visible en gráfico de torta) -->
                <div id="topCategorias" class="mt-3 text-center d-none">
                    <p class="fw-semibold mb-2">TOP CATEGORÍAS CON MAYOR GASTO EN EL PERIODO</p>
                    <div class="d-flex justify-content-around">
                        <div>
                            <div class="rounded-circle mx-auto mb-1" style="width:40px;height:40px;background:#ff6b6b;"></div>
                            <small>Comida</small>
                        </div>
                        <div>
                            <div class="rounded-circle mx-auto mb-1" style="width:40px;height:40px;background:#ffb84d;"></div>
                            <small>Transporte</small>
                        </div>
                        <div>
                            <div class="rounded-circle mx-auto mb-1" style="width:40px;height:40px;background:#4da6ff;"></div>
                            <small>Entretenimiento</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div class="col-md-5 p-4 rounded-3 shadow-sm ms-3" style="background: #a7c9f5;">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0">Presupuesto Actual</h6>
                <a href="#" class="text-decoration-none text-end">Ver Presupuestos</a>
            </div>
            <div class="progress mb-4" style="height: 25px;">
                <div class="progress-bar bg-success" role="progressbar" style="width: 25%;">25%</div>
            </div>


            <h6 class="fw-bold mb-3">Acciones Rápidas</h6>
            <div class="row mb-3">
                <div class="col-6 mb-2">
                    <a class="btn w-100 text-white" style="background: #6a5acd;">+ Agregar Gasto</a>
                </div>
                <div class="col-6 mb-2">
                    <a class="btn w-100 text-white" style="background: #6a5acd;">+ Agregar Ingreso</a>
                </div>
                <div class="col-4">
                    <a class="btn w-100 text-white" style="background: #6a5acd;">Exportar</a>
                </div>
                <div class="col-4">
                    <a class="btn w-100 text-white" style="background: #6a5acd;">Editar Presupuesto</a>
                </div>
                <div class="col-4">
                    <a class="btn w-100 text-white" style="background: #6a5acd;">Editar Perfil</a>
                </div>
            </div>


            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0">Gastos Recientes</h6>
                <a href="#" class="text-decoration-none text-end">Ver todos mis gastos</a>
            </div>
            <div class="list-group">
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <span>Panadería <small class="text-muted">Hace 2 horas</small></span>
                    <span class="text-danger fw-semibold">-$400.00</span>
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <span>Carrefour <small class="text-muted">Hace 1 día</small></span>
                    <span class="text-danger fw-semibold">-$7250.00</span>
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <span>Chino barrio <small class="text-muted">Hace 1 semana</small></span>
                    <span class="text-danger fw-semibold">-$3800.00</span>
                </div>
            </div>
        </div>

    </div>
</div>


<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
<script type="text/javascript">
    google.charts.load('current', { packages: ['corechart', 'bar'] });
    google.charts.setOnLoadCallback(initCharts);

    let currentChart = 0; // 0 = barras, 1 = torta

    function initCharts() {
        drawCurrentChart();
        updateButtons();

        document.getElementById("prevChart").addEventListener("click", () => {
            if (currentChart > 0) {
                currentChart--;
                drawCurrentChart();
                updateButtons();
            }
        });

        document.getElementById("nextChart").addEventListener("click", () => {
            if (currentChart < 1) {
                currentChart++;
                drawCurrentChart();
                updateButtons();
            }
        });
    }

    function updateButtons() {
        const prev = document.getElementById("prevChart");
        const next = document.getElementById("nextChart");

        // Reset styles
        prev.disabled = false;
        next.disabled = false;
        prev.style.opacity = "1";
        next.style.opacity = "1";

        if (currentChart === 0) {
            prev.disabled = true;
            prev.style.opacity = "0.3";
        }
        if (currentChart === 1) {
            next.disabled = true;
            next.style.opacity = "0.3";
        }
    }

    function drawCurrentChart() {
        if (currentChart === 0) drawBarChart();
        else drawPieChart();
    }

    function drawBarChart() {
        const data = google.visualization.arrayToDataTable([
            ['Categoría', 'Monto', { role: 'style' }, { role: 'annotation' }],
            ['Ingreso', 2000000, 'color: green', '$2.000.000'],
            ['Gasto', 788000, 'color: red', '$788.000'],
            ['Saldo', 1212000, 'color: yellowgreen', '$1.212.000'],
           
        ]);

        const options = {
            chartArea: { width: '80%', height: '80%' },
            backgroundColor: 'transparent',
            hAxis: {
                minValue: 0,
                gridlines: { color: 'transparent' },
                textPosition: 'none' // <--- OCULTA LOS NÚMEROS
            },
            vAxis: { textStyle: { color: '#333' } },
            legend: { position: 'none' },
            annotations: {
                alwaysOutside: true,
                textStyle: { fontSize: 12, color: '#000', auraColor: 'none' }
            },
            bars: 'horizontal'
        };

        const chart = new google.visualization.BarChart(document.getElementById('chart_div'));
        chart.draw(data, options);

        document.getElementById("topCategorias").classList.add("d-none");
    }

    function drawPieChart() {
        const data = google.visualization.arrayToDataTable([
            ['Categoría', 'Monto'],
            ['Comida', 4500],
            ['Transporte', 2300],
            ['Entretenimiento', 1800],
            ['Ropa', 1000],
            ['Otros', 700]
        ]);

        const options = {
            pieHole: 0.5,
            chartArea: { width: '90%', height: '90%' },
            backgroundColor: 'transparent',
            legend: { position: 'right', textStyle: { color: '#000', fontSize: 12 } },
            pieSliceText: 'label', // <--- MUESTRA LAS CATEGORÍAS EN LAS PORCIONES
            colors: ['#ff6b6b', '#ffb84d', '#4da6ff', '#9b59b6', '#2ecc71']
        };

        const chart = new google.visualization.PieChart(document.getElementById('chart_div'));
        chart.draw(data, options);

        document.getElementById("topCategorias").classList.remove("d-none");
    }
</script>


