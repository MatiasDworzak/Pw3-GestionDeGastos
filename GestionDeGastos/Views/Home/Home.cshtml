@using GestionDeGastos.Models.GastoModels
@model GastoViewModel
@await Html.PartialAsync("_Header")

<div class="alert alert-success">@TempData["LoginExito"]</div>

<div class="container-fluid p-4" style="background: #e3e9ff; min-height: 100vh;">
    <div class="row justify-content-center">

        <div class="col-md-5 p-4 rounded-3 shadow-sm" style="background: #a7c9f5;">
            <div class="text-center mb-3">
                <p class="fw-bold mb-0">TIEMPO ANALIZADO EN GRÁFICO:</p>
                <p id="rango-fechas">dd/mm/aaaa - dd/mm/aaaa</p>

                <form id="filtroFechasForm" class="d-flex justify-content-center gap-2 mb-3">
                    <input type="month" id="filtroMes" name="mes" class="form-control form-control-sm" style="width: 150px;">
                    <input type="date" id="desde" name="desde" class="form-control form-control-sm" style="width: 150px;">
                    <input type="date" id="hasta" name="hasta" class="form-control form-control-sm" style="width: 150px;">
                    <button type="submit" class="btn btn-sm btn-danger">Filtrar</button>
                </form>

                <!-- Contenedor de gráfico -->
                <div class="position-relative text-center">
                    <div id="chart_div" style="width: 100%; height: 300px;"></div>
                </div>

                <!-- Contenedor para el top 3 -->
                <div id="topCategorias" class="mt-3 text-center d-none">
                    <p class="fw-semibold mb-2">TOP CATEGORÍAS CON MAYOR GASTO EN EL PERIODO</p>
                    <div id="topCategoriasContenido" class="d-flex justify-content-around"></div>
                </div>
            </div>
        </div>

        <!-- COLUMNA DERECHA (Presupuesto, Acciones rápidas, etc) -->
        <div class="col-md-5 p-4 rounded-3 shadow-sm ms-3" style="background: #a7c9f5;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0">Presupuesto Actual</h6>
                <a asp-controller="Presupuesto" asp-action="PresupuestoActual" class="text-decoration-none text-end">Ver Presupuestos</a>
            </div>

            <div class="progress mb-4" style="height: 25px;">
                <div class="progress-bar bg-success" role="progressbar" style="width: 20%;">@Model.Porcentaje</div>
            </div>

            <h6 class="fw-bold mb-3">Acciones Rápidas</h6>
            <div class="row mb-3">
                <div class="col-6 mb-2">
                    <a asp-action="Agregar" asp-controller="Gasto" class="btn w-100 text-white" style="background: #6a5acd;">+ Agregar Gasto</a>
                </div>
@*                 <div class="col-6 mb-2">
                    <a class="btn w-100 text-white" style="background: #6a5acd;">+ Agregar Ingreso</a>
                </div>
                <div class="col-4">
                    <a class="btn w-100 text-white" style="background: #6a5acd;">Exportar</a>
                </div> *@
              @*   <div class="col-6">
                    <a asp-controller="Presupuesto" asp-action="PresupuestoActual" class="btn w-100 text-white" style="background: #6a5acd;">Editar Presupuesto</a>
                </div> *@
@*                 <div class="col-4">
                    <a class="btn w-100 text-white" style="background: #6a5acd;">Editar Perfil</a>
                </div> *@
            </div>

            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0">Gastos Recientes</h6>
                <a asp-controller="VerTodosLosGastos" asp-action="VerTodosLosGastos" class="text-decoration-none text-end">Ver todos mis gastos</a>
            </div>

            <div class="list-group">
                @foreach (var gasto in Model.ListaUltimosTresGastos)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@gasto.Nombre <small class="text-muted">Hace 2 horas</small></span>
                        <span class="text-danger fw-semibold">@gasto.MontoTotal</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
<script type="text/javascript">
    google.charts.load('current', { packages: ['corechart'] });
    google.charts.setOnLoadCallback(drawChartInit);

    // 🔹 Diccionario global para mantener colores consistentes
    const colorPorCategoria = {};

    // 🔹 Función para generar colores (más lindos)
    const paletaColores = [
        "#6BAED6", "#FD8D3C", "#74C476", "#9E9AC8", "#FFA07A",
        "#FDD0A2", "#A1D99B", "#C6DBEF", "#E377C2", "#BCBD22"
    ];
    let indiceColor = 0;

    function obtenerColorCategoria(categoria) {
        if (!colorPorCategoria[categoria]) {
            colorPorCategoria[categoria] = paletaColores[indiceColor % paletaColores.length];
            indiceColor++;
        }
        return colorPorCategoria[categoria];
    }

    // --- 🔹 LISTENERS para evitar conflicto entre mes y rango ---
    const filtroMesInput = document.getElementById("filtroMes");
    const desdeInput = document.getElementById("desde");
    const hastaInput = document.getElementById("hasta");

    filtroMesInput.addEventListener("change", () => {
        if (filtroMesInput.value) {
            desdeInput.value = "";
            hastaInput.value = "";
        }
    });

    desdeInput.addEventListener("change", () => {
        if (desdeInput.value) {
            filtroMesInput.value = "";
        }
    });
    hastaInput.addEventListener("change", () => {
        if (hastaInput.value) {
            filtroMesInput.value = "";
        }
    });

    // --- 🔹 FUNCIÓN PRINCIPAL ---
    async function drawChartInit() {
        const fechaActual = new Date();
        const mesActual = fechaActual.getMonth() + 1;
        const anioActual = fechaActual.getFullYear();

        const primerDia = new Date(anioActual, mesActual - 1, 1);
        const ultimoDia = new Date(anioActual, mesActual, 0);
        const nombreMes = primerDia.toLocaleString("es-ES", { month: "long" });

        document.getElementById("rango-fechas").textContent =
            `${nombreMes.charAt(0).toUpperCase() + nombreMes.slice(1)}: ${primerDia.toLocaleDateString()} al ${ultimoDia.toLocaleDateString()}`;

        const query = new URLSearchParams({ mes: `${anioActual}-${mesActual}` });
        const response = await fetch(`/Home/Filtrar?${query.toString()}`);
        const result = await response.json();

        drawPieChart(result.gastosDetallados); mostrarTopCategorias(result.top3);
    }

       function drawPieChart(gastos) {
        if (!gastos || gastos.length === 0) {
            document.getElementById('chart_div').innerHTML = '<p class="text-muted">No hay gastos para mostrar.</p>';
            return;
        }

        const dataArray = [['Categoría', 'Monto']];
        const colores = [];

        gastos.forEach(g => {
            dataArray.push([g.categoria, g.totalCategoria]); 
            colores.push(obtenerColorCategoria(g.categoria));
        });

        const data = google.visualization.arrayToDataTable(dataArray);

        const options = {
            pieHole: 0.5,
            chartArea: { width: '90%', height: '90%' },
            backgroundColor: 'transparent',
            legend: { position: 'right', textStyle: { color: '#000', fontSize: 12 } },
            pieSliceText: 'label',
            colors: colores
        };

        const chart = new google.visualization.PieChart(document.getElementById('chart_div'));
        chart.draw(data, options);
        document.getElementById("topCategorias").classList.remove("d-none");
    }

    function mostrarTopCategorias(top3) {
        const contenedor = document.getElementById("topCategoriasContenido");

        if (!top3 || top3.length === 0) {
            contenedor.innerHTML = '<small class="text-muted">No hay categorías para mostrar.</small>';
            return;
        }

        contenedor.innerHTML = top3.map(cat => {
            const color = obtenerColorCategoria(cat.categoria);
            return `
                <div class="text-center">
                    <div class="rounded-circle mx-auto mb-1" style="width:40px;height:40px;background:${color};"></div>
                    <small>${cat.categoria} ($${cat.total.toFixed(2)})</small> <!-- ✅ corregido -->
                </div>
            `;
        }).join('');
    }

    // --- 🔹 Submit del filtro ---
    document.getElementById("filtroFechasForm").addEventListener("submit", async (e) => {
        e.preventDefault();

        const mes = filtroMesInput.value;
        const desde = desdeInput.value;
        const hasta = hastaInput.value;
        // if (hasta.value = ""){
        //    const fechaActualDia = new Date()
        //     hasta.value = fechaActualDia.getDate()
        // }
        const query = new URLSearchParams();

        if (desde && hasta) {
            query.set("desde", desde);
            query.set("hasta", hasta);
        } else if (mes) {
            query.set("mes", mes);
        }

        const response = await fetch(`/Home/Filtrar?${query.toString()}`);
        const result = await response.json();

        drawPieChart(result.gastosDetallados);
        mostrarTopCategorias(result.top3);

        if (desde && hasta) {
            document.getElementById("rango-fechas").textContent = `${desde} al ${hasta}`;
        } else if (mes) {
            const [anio, mesNum] = mes.split("-");
            const primerDia = new Date(anio, mesNum - 1, 1);
            const ultimoDia = new Date(anio, mesNum, 0);
            const nombreMes = primerDia.toLocaleString("es-ES", { month: "long" });
            document.getElementById("rango-fechas").textContent =
                `${nombreMes.charAt(0).toUpperCase() + nombreMes.slice(1)}: ${primerDia.toLocaleDateString()} al ${ultimoDia.toLocaleDateString()}`;
        }
    });
</script>
