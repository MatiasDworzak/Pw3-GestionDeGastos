@using GestionDeGastos.Models.GastoModels
@model GastoViewModel
@await Html.PartialAsync("_Header")

@section Css {
    <link rel="stylesheet" href="~/css/custom-styles.css">
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="container-fluid p-4" style="background: #DFDCE3; min-height: 100vh;">
    <div class="row justify-content-center">
        <!-- COLUMNA IZQUIERDA: Gráfico -->
        <div class="col-md-5 p-4 rounded-3 shadow-sm" style="background: #4ABDAC;">
            <div class="text-center mb-3">
                <p class="fw-bold mb-0 text-white">TIEMPO ANALIZADO EN GRÁFICO:</p>
                <p id="rango-fechas" class="text-white opacity-75">dd/mm/aaaa - dd/mm/aaaa</p>

                <form id="filtroFechasForm" class="d-flex justify-content-center gap-2 mb-3 flex-wrap">
                    <input type="month" id="filtroMes" name="mes" class="form-control form-control-sm" style="width: 150px;">
                    <input type="date" id="desde" name="desde" class="form-control form-control-sm" style="width: 150px;">
                    <input type="date" id="hasta" name="hasta" class="form-control form-control-sm" style="width: 150px;">
                    <button type="submit" class="btn btn-sm text-white fw-semibold" style="background: #FC4A1A;">Filtrar</button>
                </form>

                <!-- Contenedor de gráfico -->
                <div class="position-relative text-center bg-white rounded-3 p-3 shadow-sm">
                    <div id="chart_div" style="width: 100%; height: 300px;"></div>
                </div>

                <!-- Contenedor para el top 3 -->
                <div id="topCategorias" class="mt-3 text-center d-none">
                    <p class="fw-semibold mb-2 text-white">TOP CATEGORÍAS CON MAYOR GASTO EN EL PERIODO</p>
                    <div id="topCategoriasContenido" class="d-flex justify-content-around flex-wrap"></div>
                </div>
            </div>
        </div>

        <!-- COLUMNA DERECHA: Presupuesto y Gastos Recientes -->
        <div class="col-md-5 p-4 rounded-3 shadow-sm ms-3" style="background: #4ABDAC;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0 d-flex align-items-center text-white">
                    Presupuesto Actual
                    @if (Model.LimitePresupuesto == 0)
                    {
                        <span class="bi bi-exclamation-triangle-fill text-warning ms-2"
                              data-bs-toggle="tooltip"
                              data-bs-placement="top"
                              title="Tu presupuesto está en $0. Agregá un monto para empezar a planificar.">
                        </span>
                    }
                </h6>
                <a asp-controller="Presupuesto" asp-action="PresupuestoActual" class="text-white text-decoration-none">Ver Presupuestos</a>
            </div>

            @{
                string progressColor = Model.Porcentaje switch
                {
                    var porcentaje when porcentaje < 50 => "#4ABDAC",
                    var porcentaje when porcentaje >= 50 && porcentaje < 80 => "#F7B733",
                    _ => "#FC4A1A",
                };
            }

            <div class="progress mb-4" style="height: 25px; background: rgba(255,255,255,0.3);">
                <div class="progress-bar" role="progressbar"
                     style="width:@Model.Porcentaje.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%; background: @progressColor;">
                    <span class="fw-semibold">@Model.Porcentaje.ToString("0.##")%</span>
                </div>
            </div>
            <h6 class="fw-bold mb-3 text-white">Acciones Rápidas</h6>
            <div class="row mb-4">
                <div class="col-12 mb-2">
                    <a asp-action="Agregar" asp-controller="Gasto" class="btn w-100 text-dark shadow-sm fw-semibold" style="background: #F7B733; padding: 12px;">
                        <i class="bi bi-plus-circle me-2"></i>Agregar Gasto
                    </a>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0 text-white">Gastos Recientes</h6>
                <a asp-controller="VerTodosLosGastos" asp-action="VerTodosLosGastos" class="text-white text-decoration-none">Ver todos</a>
            </div>
            <div class="list-group">
                @foreach (var gasto in Model.ListaUltimosTresGastos)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center py-3 border-0 mb-2 shadow-sm">
                        <a asp-controller="GastoEspecifico"
                           asp-action="GastoEspecifico"
                           asp-route-id="@gasto.IdGasto"
                           class="d-flex justify-content-between align-items-center w-100"
                           style="text-decoration:none; color:inherit;">

                            <div class="d-flex align-items-center">
                                <span class="material-icons"
                                      style="color:@gasto.IdCategoriaNavigation.Color; font-size:1.8rem; margin-right:10px;">
                                    @gasto.IdCategoriaNavigation.Icono
                                </span>

                                <div>
                                    <div class="fw-semibold" style="font-size:1.1rem;">@gasto.Nombre</div>
                                    <small class="text-muted">@gasto.Fecha.ToString("dd/MM/yyyy")</small>
                                </div>
                            </div>

                            <span class="text-secondary fw-bold" style="font-size:1.1rem;">
                                @gasto.MontoTotal.ToString("C2")
                            </span>
                        </a>
                    </div>
                }
            </div>

        </div>
    </div>
</div>
<script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
<script type="text/javascript" src="~/js/FiltradoPorFechaYGraficoDeGastos.js"></script>
@section Scripts{
    <script>
        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        tooltipTriggerList.forEach(el => new bootstrap.Tooltip(el));
    </script>
}
