@model GestionDeGastos.Models.GastoModels.GastoPorCategoriaViewModel
@await Html.PartialAsync("_Header")

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ver Todos Los Gastos</title>
    <style>
        /* --- estilos previos --- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .main-container {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            height: calc(100vh - 40px);
        }

        .left-section {
            background: rgba(173, 216, 230, 0.4);
            border-radius: 15px;
            padding: 30px;
            display: flex;
            flex-direction: column;
        }

        .chart-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: rgba(173, 216, 230, 0.3);
            border-radius: 10px;
            padding: 20px;
        }

        #chart_div {
            flex: 1;
            min-height: 300px;
        }

        .right-section {
            background: #ff6b6b;
            border-radius: 15px;
            padding: 30px;
            display: flex;
            flex-direction: column;
        }

            .right-section h2 {
                color: white;
                text-align: center;
                margin-bottom: 20px;
                font-size: 22px;
                font-weight: 700;
            }

        .gastos-list {
            flex: 1;
            overflow-y: auto;
            margin-bottom: 20px;
        }

        .gasto-item {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 10px;
            margin-bottom: 12px;
        }

        .gasto-descripcion, .gasto-monto {
            background: rgba(135, 206, 235, 0.7);
            padding: 12px 15px;
            border-radius: 8px;
            font-size: 14px;
            color: #333;
            font-weight: 500;
        }

        .gasto-monto {
            background: rgba(70, 130, 180, 0.8);
            text-align: right;
            color: white;
            font-weight: 600;
        }

        .ver-mas-btn {
            width: 100%;
            padding: 12px;
            background: transparent;
            color: white;
            border: 2px solid white;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .ver-mas-btn:hover {
                background: white;
                color: #ff6b6b;
            }

        .no-data {
            text-align: center;
            color: white;
            padding: 40px;
            font-size: 16px;
        }

        @@media (max-width: 1024px) {
            .main-container {
                grid-template-columns: 1fr;
                height: auto;
            }
        }
    </style>
</head>
<body>
    <div class="main-container">
        <!-- Sección Izquierda -->
        <div class="left-section">
            <div class="col-md-5 p-4 rounded-3 shadow-sm" style="background: #a7c9f5;">
                <div class="text-center mb-3">
                    <p class="fw-bold mb-0">TIEMPO ANALIZADO EN GRÁFICO:</p>
                    <p id="rango-fechas">dd/mm/aaaa - dd/mm/aaaa</p>

                    <form id="filtroFechasForm" class="d-flex justify-content-center gap-2 mb-3">
                        <input type="month" id="filtroMes" name="mes" class="form-control form-control-sm" style="width: 150px;">
                        <input type="date" id="desde" name="desde" class="form-control form-control-sm" style="width: 150px;">
                        <input type="date" id="hasta" name="hasta" class="form-control form-control-sm" style="width: 150px;">
                        <button type="submit" class="btn btn-sm btn-danger">Filtrar</button>
                    </form>

                    <!-- Contenedor de gráfico -->
                    <div class="position-relative text-center">
                        <div id="chart_div" style="width: 100%; height: 300px;"></div>
                    </div>

                    <!-- Contenedor para el top 3 -->
                    <div id="topCategorias" class="mt-3 text-center d-none">
                        <p class="fw-semibold mb-2">TOP CATEGORÍAS CON MAYOR GASTO EN EL PERIODO</p>
                        <div id="topCategoriasContenido" class="d-flex justify-content-around"></div>
                    </div>
                </div>
            </div>

        </div>
        <!-- Sección Derecha -->
        <div class="right-section">
            <h2>TUS GASTOS</h2>
            <div id="gastos-list" class="gastos-list">
                <div class="no-data">Cargando gastos...</div>
            </div>
            <button class="ver-mas-btn">VER MAS</button>
        </div>

    <!-- Google Charts -->

        <script src="https://www.gstatic.com/charts/loader.js"></script>
        <script src="~/js/FiltradoPorFechaYGraficoDeGastos.js"></script>

    </script>
</body>
</html>