@model GastoEspecificoViewModel
@await Html.PartialAsync("_Header")

<link rel="stylesheet" href="~/css/gasto-especifico.css" />

<div class="page-container">
    <div class="page-header">
        <h1>📄 Detalle del Gasto</h1>
        <p class="subtitle">Información completa del gasto seleccionado</p>
    </div>

    <div class="detail-card">
        <div class="detail-section">
            <h3>📋 Información General</h3>
            <div class="detail-content-wrapper">
                <div class="detail-grid">
                    <div class="detail-item">
                        <span class="detail-label">Nombre del Gasto</span>
                        <div class="detail-value">@Model.Nombre</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Monto</span>
                        <div class="detail-value monto">@Model.Monto.ToString("C")</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Categoría</span>
                        <div class="detail-value">@Model.Categoria.NombreCategoria</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Método de Pago</span>
                        <div class="detail-value">@Model.MetodoDePago.NombreMetodoDePago</div>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Fecha</span>
                        <div class="detail-value">@Model.Fecha.ToShortDateString()</div>
                    </div>
                </div>

                @if (Model.Ticket != null && Model.Ticket.IdTicket != 0 && Model.Ticket.URLFoto != "")
                {
                    <div class="image-section">
                        <img src="https://gestiondegastostickets.blob.core.windows.net/tickets/@Model.Ticket.URLFoto" 
                             alt="@Model.Ticket.URLFoto" 
                             class="image-preview"
                             data-bs-toggle="modal"
                             data-bs-target="#modalImagen" />
                    </div>
                }
            </div>
        </div>

        @if (Model.Ticket != null && Model.Ticket.IdTicket != 0)
        {
            <div class="ticket-section">
                <div class="ticket-header">
                    <h4>🧾 Ticket Asociado</h4>
                    <span class="ticket-id">#@Model.Ticket.IdTicket</span>
                </div>

                @if (Model.Items != null && Model.Items.Any())
                {
                    <table class="items-table">
                        <thead>
                            <tr>
                                <th>Cantidad</th>
                                <th>Descripción</th>
                                <th>Precio Unitario</th>
                                <th>Precio Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.Cantidad</td>
                                    <td>@item.Descripcion</td>
                                    <td>@item.PrecioUnitario.ToString("C")</td>
                                    <td><strong>@item.PrecioTotal.ToString("C")</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
        else
        {
            <div class="ticket-section">
                <div class="no-ticket">
                    <div class="no-ticket-icon">🧾</div>
                    <div>Este gasto no contiene ticket</div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal con imagen ampliada -->
<div class="modal fade" id="modalImagen" tabindex="-1" aria-labelledby="modalImagenLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-body text-center">
                <img src="https://gestiondegastostickets.blob.core.windows.net/tickets/@Model.Ticket.URLFoto" 
                     class="img-fluid" 
                     alt="@Model.Ticket.URLFoto" />
            </div>
        </div>
    </div>
</div>
