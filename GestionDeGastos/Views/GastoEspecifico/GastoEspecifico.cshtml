@{

}
@model GastoEspecificoViewModel
@*
    Espacio para header
*@

<div> @*Contenedor general*@
    <div class="container text-center"> @*Contenedor con datos genericos*@
        <div class="row">
            <div class="col-md-8 border border-danger"> @*Columna para datos escritos*@
                <div class="row">
                    <div class="col-md-6 bg-primary">
                        @Model.Nombre
                    </div>
                    <div class="col-md-6 bg-secondary">
                        @Model.Monto.ToString("C")
                    </div>
                    <div class="col-md-4 bg-danger">
                        @Model.Categoria
                    </div>
                    <div class="col-md-4 bg-success">
                        @Model.MetodoDePago
                    </div>
                    <div class="col-md-4 bg-warning">
                        @Model.Fecha.ToShortDateString()
                    </div>
                </div>
            </div>
            <div class="col-md-4 border border-primary"> @*Columna para foto*@
                <img src="@Model.URLFoto" alt="Alternate Text"/>
            </div>
        </div>
    </div>

