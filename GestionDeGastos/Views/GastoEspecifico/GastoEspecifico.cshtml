@model GastoEspecificoViewModel
@await Html.PartialAsync("_Header")

<link rel="stylesheet" href="~/css/gasto-especifico.css" />

    <!-- Datos del gasto -->
    <div class="row g-3 align-items-center border-bottom pb-3 mb-3">
        <div class="col-md-8">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold text-secondary small">Nombre del gasto</label>
                    <div class="p-2 bg-white border rounded">@Model.Nombre</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-secondary small">Monto</label>
                    <div class="p-2 bg-white border rounded">@Model.Monto.ToString("C")</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold text-secondary small">Categoría</label>
                    <div class="p-2 bg-white border rounded d-flex align-items-center">
                        <span class="material-icons"
                              style="color:@Model.Categoria.Color; margin-right:10px;">
                            @Model.Categoria.Icono
                        </span>
                        @Model.Categoria.NombreCategoria
                        </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold text-secondary small">Método de pago</label>

                    <div class="p-2 bg-white border rounded d-flex align-items-center">
                        <span class="material-icons"
                              style="color:@Model.MetodoDePago.Color; font-size:1.8rem; margin-right:10px;">
                            @Model.MetodoDePago.Icono
                        </span>
                        @Model.MetodoDePago.NombreMetodoDePago
                        </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold text-secondary small">Fecha</label>
                    <div class="p-2 bg-white border rounded">@Model.Fecha.ToShortDateString()</div>
                </div>
            </div>
        </div>

                @if (Model.Ticket != null && Model.Ticket.IdTicket != 0 && Model.Ticket.URLFoto != "")
                {
                    <div class="image-section">
                        <img src="https://gestiondegastostickets.blob.core.windows.net/tickets/@Model.Ticket.URLFoto" 
                             alt="@Model.Ticket.URLFoto" 
                             class="image-preview"
                             data-bs-toggle="modal"
                             data-bs-target="#modalImagen" />
                    </div>
                }
            </div>
        </div>

        @if (Model.Ticket != null && Model.Ticket.IdTicket != 0)
        {
            <div class="ticket-section">
                <div class="ticket-header">
                    <h4>🧾 Ticket Asociado</h4>
                    <span class="ticket-id">#@Model.Ticket.IdTicket</span>
                </div>

                @if (Model.Items != null && Model.Items.Any())
                {
                    <table class="items-table">
                        <thead>
                            <tr>
                                <th>Cantidad</th>
                                <th>Descripción</th>
                                <th>Precio Unitario</th>
                                <th>Precio Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.Cantidad</td>
                                    <td>@item.Descripcion</td>
                                    <td>@item.PrecioUnitario.ToString("C")</td>
                                    <td><strong>@item.PrecioTotal.ToString("C")</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-light border text-center text-muted" role="alert">
            Este gasto no contiene ticket
        </div>
    }
    <a class="btn btn-danger" asp-controller="Gasto" asp-action="Eliminar" asp-route-id="@Model.IdGasto">Eliminar Gasto</a>
</div>

<!-- Modal con imagen ampliada -->
<div class="modal fade" id="modalImagen" tabindex="-1" aria-labelledby="modalImagenLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-body text-center">
                <img src="https://gestiondegastostickets.blob.core.windows.net/tickets/@Model.Ticket.URLFoto" 
                     class="img-fluid" 
                     alt="@Model.Ticket.URLFoto" />
            </div>
        </div>
    </div>
</div>
