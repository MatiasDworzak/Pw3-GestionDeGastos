@model GastoEspecificoViewModel
@await Html.PartialAsync("_Header")

@section Css {
    <link rel="stylesheet" href="~/css/custom-styles.css">
}

<div class="container-fluid p-4" style="min-height: 100vh;">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Card Principal -->
            <div class="card border-0 shadow-lg mb-4" style="border-radius: 20px;">
                <div class="card-header border-0 text-white" style="background: #4ABDAC; border-radius: 20px 20px 0 0; padding: 2rem;">
                    <h3 class="mb-0 fw-bold text-center">
                        <i class="bi bi-receipt-cutoff me-2"></i>Detalle del Gasto
                    </h3>
                </div>
                
                <div class="card-body p-4">
                    <!-- Información Principal -->
                    <div class="row g-4 mb-4">
                        <!-- Columna Izquierda: Datos -->
                        <div class="col-md-8">
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <div class="card border-0 shadow-sm">
                                        <div class="card-body">
                                            <label class="form-label fw-bold text-muted small mb-2">
                                                <i class="bi bi-tag me-2" style="color: #4ABDAC;"></i>Nombre del Gasto
                                            </label>
                                            <h5 class="mb-0 fw-bold">@Model.Nombre</h5>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-md-6">
                                    <div class="card border-0 shadow-sm">
                                        <div class="card-body">
                                            <label class="form-label fw-bold text-muted small mb-2">
                                                <i class="bi bi-cash-stack me-2" style="color: #F7B733;"></i>Monto Total
                                            </label>
                                            <h4 class="mb-0 fw-bold" style="color: #FC4A1A;">@Model.Monto.ToString("C")</h4>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-md-6">
                                    <div class="card border-0 shadow-sm">
                                        <div class="card-body">
                                            <label class="form-label fw-bold text-muted small mb-2">
                                                <i class="bi bi-calendar3 me-2" style="color: #4ABDAC;"></i>Fecha
                                            </label>
                                            <h5 class="mb-0">@Model.Fecha.ToString("dd/MM/yyyy")</h5>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-md-6">
                                    <div class="card border-0 shadow-sm">
                                        <div class="card-body">
                                            <label class="form-label fw-bold text-muted small mb-2">
                                                <i class="bi bi-grid-3x3-gap me-2" style="color: #4ABDAC;"></i>Categoría
                                            </label>
                                            <div class="d-flex align-items-center">
                                                <span class="material-icons me-2" style="color:@Model.Categoria.Color; font-size: 1.8rem;">
                                                    @Model.Categoria.Icono
                                                </span>
                                                <span class="fw-semibold">@Model.Categoria.NombreCategoria</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-md-6">
                                    <div class="card border-0 shadow-sm">
                                        <div class="card-body">
                                            <label class="form-label fw-bold text-muted small mb-2">
                                                <i class="bi bi-credit-card me-2" style="color: #4ABDAC;"></i>Método de Pago
                                            </label>
                                            <div class="d-flex align-items-center">
                                                <span class="material-icons me-2" style="color:@Model.MetodoDePago.Color; font-size: 1.8rem;">
                                                    @Model.MetodoDePago.Icono
                                                </span>
                                                <span class="fw-semibold">@Model.MetodoDePago.NombreMetodoDePago</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Columna Derecha: Imagen -->
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body text-center d-flex flex-column justify-content-center">
                                    @if (Model.Ticket != null && Model.Ticket.IdTicket != 0 && Model.Ticket.URLFoto != "")
                                    {
                                        <label class="form-label fw-bold text-muted small mb-3">
                                            <i class="bi bi-image me-2" style="color: #4ABDAC;"></i>Foto del Ticket
                                        </label>
                                        <img src="https://gestiondegastostickets.blob.core.windows.net/tickets/@Model.Ticket.URLFoto" 
                                             alt="Ticket" 
                                             class="img-fluid rounded shadow-sm"
                                             style="cursor: pointer; max-height: 300px; object-fit: cover;"
                                             data-bs-toggle="modal"
                                             data-bs-target="#modalImagen" />
                                        <small class="text-muted mt-2">Click para ampliar</small>
                                    }
                                    else
                                    {
                                        <div class="text-center p-4">
                                            <i class="bi bi-image" style="font-size: 4rem; color: #DFDCE3;"></i>
                                            <p class="text-muted mt-3 mb-0">Este gasto no contiene imagen</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Sección de Ticket e Items -->
                    @if (Model.Ticket != null && Model.Ticket.IdTicket != 0)
                    {
                        <div class="card border-0 shadow-sm mb-4" style="background: #DFDCE3;">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="fw-bold mb-0" style="color: #4ABDAC;">
                                        <i class="bi bi-receipt me-2"></i>Ticket Asociado
                                    </h5>
                                    <span class="badge rounded-pill px-3 py-2" style="background: #4ABDAC; font-size: 0.9rem;">
                                        #@Model.Ticket.IdTicket
                                    </span>
                                </div>

                                @if (Model.Items != null && Model.Items.Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0 bg-white rounded">
                                            <thead style="background: #4ABDAC; color: white;">
                                                <tr>
                                                    <th scope="col" class="py-3">Cant.</th>
                                                    <th scope="col" class="py-3">Descripción</th>
                                                    <th scope="col" class="py-3">Precio Unit.</th>
                                                    <th scope="col" class="py-3">Precio Total</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model.Items)
                                                {
                                                    <tr>
                                                        <td class="fw-semibold">@item.Cantidad</td>
                                                        <td>@item.Descripcion</td>
                                                        <td>@item.PrecioUnitario.ToString("C")</td>
                                                        <td class="fw-bold" style="color: #FC4A1A;">@item.PrecioTotal.ToString("C")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert border-0 text-center" style="background: #DFDCE3;" role="alert">
                            <i class="bi bi-info-circle me-2" style="color: #4ABDAC;"></i>
                            <span class="fw-semibold">Este gasto no contiene ticket</span>
                        </div>
                    }

                    <!-- Botones de Acción -->
                    <div class="d-flex justify-content-between gap-2">
                        <a class="btn btn-lg btn-secondary px-4" asp-controller="Home" asp-action="Home">
                            <i class="bi bi-arrow-left me-2"></i>Volver
                        </a>
                        <a class="btn btn-lg text-white fw-semibold px-4" 
                           style="background: #FC4A1A;" 
                           asp-controller="Gasto" 
                           asp-action="Eliminar" 
                           asp-route-id="@Model.IdGasto"
                           onclick="return confirm('¿Estás seguro de que deseas eliminar este gasto?');">
                            <i class="bi bi-trash me-2"></i>Eliminar Gasto
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal con Imagen Ampliada -->
<div class="modal fade" id="modalImagen" tabindex="-1" aria-labelledby="modalImagenLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bg-transparent border-0 shadow-none">
            <div class="modal-header border-0">
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-0">
                <img src="https://gestiondegastostickets.blob.core.windows.net/tickets/@Model.Ticket?.URLFoto" 
                     class="img-fluid rounded shadow-lg" 
                     alt="Ticket" 
                     style="max-height: 90vh; object-fit: contain;" />
            </div>
        </div>
    </div>
</div>
