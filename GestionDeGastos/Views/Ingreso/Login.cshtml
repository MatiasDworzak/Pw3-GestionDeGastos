@model CredencialViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<link rel="stylesheet" href="~/css/login.css" />

<div class="container-fluid vh-100">
    <div class="row h-100">
        <!-- Columna izquierda - Imagen -->
        <div class="col-md-6 d-none d-md-block p-0"
             style="background-image: url('@Url.Content("~/img/Ingreso/LoginImagen.jpg")');
                    background-size: cover;
                    background-position: center;
                    background-repeat: no-repeat;">

            <div class="h-100 d-flex align-items-center justify-content-center" style="background-color: rgba(0,0,0,0.3);">
                <div class="text-center text-white p-5">
                    <i class="bi bi-receipt-cutoff" style="font-size: 140px; opacity: 0.9;"></i>
                    <h2 class="mt-4 fw-bold" style="font-size: 36px;">AhorrApp</h2>
                    <p class="lead" style="font-size: 20px;">Controla tus gastos de manera inteligente</p>
                </div>
            </div>

        </div>

        <!-- Columna derecha - Formulario -->
        <div class="col-md-6 d-flex align-items-center justify-content-center login-form-container">
            <div class="login-form-wrapper-full">
                <h1 class="login-title">¡Bienvenido!</h1>

                @if (TempData["RegistroExito"] != null)
                {
                    <div class="alert alert-success login-alert" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["RegistroExito"]
                    </div>
                }
                <div asp-validation-summary="ModelOnly" class="alert alert-danger login-alert" role="alert"></div>

                <form asp-action="Login" method="post" class="login-form">
                    <div class="form-group-login">
                        <label asp-for="Correo" class="form-label-login">Correo Electrónico</label>
                        <input asp-for="Correo" class="form-control-login" placeholder="tu@email.com" />
                        <span asp-validation-for="Correo" class="text-danger-login"></span>
                    </div>
                    <div class="form-group-login">
                        <label asp-for="Contrasenia" class="form-label-login">Contraseña</label>
                        <input asp-for="Contrasenia" type="password" class="form-control-login" placeholder="••••••••" />
                        <span asp-validation-for="Contrasenia" class="text-danger-login"></span>
                    </div>
                    <div class="login-button-container">
                        <button type="submit" class="btn-login">
                            Ingresar
                        </button>
                    </div>
                    <div class="login-link-container">
                        <p class="login-link-text">¿No tienes cuenta? <a asp-action="Register" class="login-link">Regístrate</a></p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}