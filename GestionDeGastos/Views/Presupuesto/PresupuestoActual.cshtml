@model PresupuestoPaginaViewModel
@{
    ViewData["Title"] = "Presupuesto actual";
}
@await Html.PartialAsync("_Header")

@section Css {
    <link rel="stylesheet" href="~/css/custom-styles.css">
}

<div class="container-fluid p-4" style="background: #DFDCE3; min-height: 100vh;">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Card Principal del Presupuesto Actual -->
            <div class="card border-0 shadow-lg mb-4" style="background: #4ABDAC; border-radius: 20px;">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <h2 class="fw-bold text-white mb-1">
                            <i class="bi bi-wallet2 me-2"></i>Presupuesto Mensual
                        </h2>
                        <p class="text-white opacity-75">Gestiona tu presupuesto y controla tus gastos</p>
                    </div>

                    <!-- Montos -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body text-center p-4">
                                    <i class="bi bi-cash-stack" style="font-size: 2.5rem; color: #4ABDAC;"></i>
                                    <h6 class="text-muted mt-3 mb-2">Monto Total</h6>
                                    <h3 class="fw-bold mb-0" style="color: #4ABDAC;">@($"{Model.UltimoPresupuesto.MontoLimite:C}")</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body text-center p-4">
                                    <i class="bi bi-cart-check" style="font-size: 2.5rem; color: #FC4A1A;"></i>
                                    <h6 class="text-muted mt-3 mb-2">Monto Gastado</h6>
                                    <h3 class="fw-bold mb-0" style="color: #FC4A1A;">@($"{Model.UltimoPresupuesto.MontoActualGastado:C}")</h3>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Barra de Progreso -->
                    @{
                        string progressColor = Model.PorcentajeGastado switch
                        {
                            var porcentaje when porcentaje < 50 => "#4ABDAC",
                            var porcentaje when porcentaje >= 50 && porcentaje < 80 => "#F7B733",
                            _ => "#FC4A1A",
                        };
                    }

                    <div class="bg-white rounded-3 p-4 shadow-sm mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-semibold">Progreso del Presupuesto</span>
                            <span class="badge rounded-pill px-3 py-2" style="background: @progressColor; font-size: 1rem;">
                                @Model.PorcentajeGastado.ToString("0.##")%
                            </span>
                        </div>
                        <div class="progress" style="height: 30px; border-radius: 15px;">
                            <div class="progress-bar" role="progressbar"
                                 style="width:@Model.PorcentajeGastado.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%; background: @progressColor;">
                            </div>
                        </div>
                    </div>

                    <!-- Botón Editar -->
                    <div class="text-center">
                        <button class="btn btn-lg text-dark shadow-sm px-5 fw-semibold" 
                                style="background: #F7B733; border-radius: 25px;"
                                data-bs-toggle="modal" 
                                data-bs-target="#modalEditarMontoTotal">
                            <i class="bi bi-pencil-square me-2"></i>Editar Presupuesto
                        </button>
                    </div>
                </div>
            </div>

            <!-- Historial de Presupuestos -->
            <div class="card border-0 shadow-lg" style="border-radius: 20px;">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-4" style="color: #4ABDAC;">
                        <i class="bi bi-clock-history me-2"></i>Historial de Presupuestos
                    </h4>
                    
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead style="background: #DFDCE3;">
                                <tr>
                                    <th scope="col" class="py-3">
                                        <i class="bi bi-calendar3 me-2"></i>Fecha
                                    </th>
                                    <th scope="col" class="py-3">
                                        <i class="bi bi-piggy-bank me-2"></i>Monto Establecido
                                    </th>
                                    <th scope="col" class="py-3">
                                        <i class="bi bi-receipt me-2"></i>Monto Gastado
                                    </th>
                                    <th scope="col" class="py-3 text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var presupuesto in Model.ListaPresupuestos)
                                {
                                    <tr>
                                        <td class="fw-semibold">@presupuesto.Mes / @presupuesto.Anio</td>
                                        <td>@($"{presupuesto.MontoLimite:C}")</td>
                                        <td>@($"{presupuesto.MontoActualGastado:C}")</td>
                                        <td class="text-center">
                                            <a class="btn btn-sm text-white shadow-sm fw-semibold" 
                                               style="background: #FC4A1A; border-radius: 20px;"
                                               asp-controller="VerTodosLosGastos" 
                                               asp-action="MostrarGastosPresupuesto" 
                                               asp-route-mes="@presupuesto.Mes" 
                                               asp-route-anio="@presupuesto.Anio">
                                                <i class="bi bi-eye me-1"></i>Ver Gastos
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Editar Presupuesto -->
<div class="modal fade" id="modalEditarMontoTotal" tabindex="-1" aria-labelledby="modalEditarMontoTotal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0" style="background: #4ABDAC; border-radius: 20px 20px 0 0;">
                <h5 class="modal-title text-white fw-bold" id="modalEditarMontoTotal">
                    <i class="bi bi-wallet2 me-2"></i>Nuevo Presupuesto
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form action="PresupuestoActual" method="post">
                    <div class="mb-4">
                        <label class="form-label fw-semibold mb-3">
                            <i class="bi bi-currency-dollar me-2" style="color: #4ABDAC;"></i>
                            Ingrese el monto total para el nuevo presupuesto:
                        </label>
                        <input type="text" 
                               class="form-control form-control-lg" 
                               placeholder="Ejemplo: 1.000.000" 
                               name="NuevoMonto"
                               style="border: 2px solid #DFDCE3; border-radius: 10px;">
                    </div>
                    <div class="d-grid">
                        <button type="submit" 
                                class="btn btn-lg text-dark shadow-sm fw-semibold" 
                                style="background: #F7B733; border-radius: 10px;">
                            <i class="bi bi-check-circle me-2"></i>Confirmar Presupuesto
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
